# Copy to .env for local testing (never commit the real .env -- it's gitignored).
# In GitHub Actions, these are set as repository secrets instead, not read from a file.

SUPABASE_URL=https://ivxftbgzxxdacizxwnhc.supabase.co

# Project Settings > API > service_role secret (NOT the publishable/anon key).
# Required because active_listings has no RLS policy allowing anon inserts;
# the service role key bypasses RLS and must only ever live in GitHub
# Actions secrets or a local, gitignored .env -- never in committed code.
SUPABASE_SERVICE_KEY=
